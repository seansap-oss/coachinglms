{
  "name": "cafe-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "echo \"No tests yet — see tests/\" && exit 0",
    "test:e2e": "npx playwright test",
    "db:migrate": "echo \"Run supabase/migrations/*.sql in Supabase SQL editor\"",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "npm run db:migrate && npm run db:seed",
    "images:generate": "tsx scripts/generate-product-images.ts",
    "catalogue:india:audit": "tsx scripts/catalogue-india-audit.ts",
    "verify": "npm run typecheck && npm run lint && npm run build"
  },
  "dependencies": {
    "@vercel/blob": "^2.6.1",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "uuid": "^14.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
